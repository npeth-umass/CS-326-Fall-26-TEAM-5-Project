PORT=3000
NODE_ENV=development

# MongoDB connection string. Local example (no auth):
#   mongodb://localhost:27017/congress_watch
# With a username and password, or MongoDB Atlas:
#   mongodb://USER:PASSWORD@HOST:27017/DBNAME?authSource=admin
MONGODB_URI=mongodb://localhost:27017/congress_watch
# Run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# to change the session secret
SESSION_SECRET=change-me
