<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Trades</title>
    <link rel="stylesheet" href="/style.css">
    <meta
      name="htmx-config"
      content='{
        "timeout": 5000,
        "responseHandling": [
          { "code": "204", "swap": false },
          { "code": "[23]..", "swap": true },
          { "code": "[45]..", "swap": true, "error": true, "target": "#status", "swapOverride": "innerHTML" }
        ]
      }'
    >
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body
    hx-on::send-error="document.querySelector('#status').textContent = 'Could not reach the server.'"
    hx-on::timeout="document.querySelector('#status').textContent = 'The server did not answer within five seconds.'"
  >
    <%- include('partials/header') %>
    <main>
      <h1>Trades</h1>
      <%- include('partials/trades-form') %>
      <ul id="entries">
        <% trades.forEach((trade) => { %>
          <%- include('partials/trade', { trade }) %>
        <% }); %>
      </ul>
    </main>
  </body>
</html>
