<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Trades</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <h1>Trades</h1>

      <!-- Handled by /form.js: sends JSON to POST /trades with fetch -->
      <form id="entry-form" class="entry-form" data-endpoint="/trades" data-kind="trade">
        <h2>Add a trade</h2>
        <p class="form-error" role="alert" hidden></p>
        <input type="text" name="name" placeholder="Politician (Last, First)">
        <input type="text" name="stock" placeholder="Stock">
        <input type="number" name="shares" placeholder="Shares" min="1" step="1">
        <input type="number" name="pricePerShare" placeholder="Price per share ($)" min="0.01" step="0.01">
        <button type="submit">Add Trade</button>
      </form>

      <ul id="entries">
        <% trades.forEach((trade, index) => { %>
          <li data-id="<%= index %>">
            <span><strong><%= trade.name %>:</strong> <%= trade.stock %>, <%= trade.shares %> shares at $<%= trade.pricePerShare %>/share, $<%= trade.totalSpent %> total</span>
            <button class="delete-btn" type="button">Delete</button>
          </li>
        <% }); %>
      </ul>
    </main>
    <script src="/form.js" defer></script>
  </body>
</html>