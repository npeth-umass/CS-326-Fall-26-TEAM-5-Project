<form
  id="entry-form"
  class="entry-form flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center"
  hx-post="/trades"
  hx-target="#entries"
  hx-swap="beforeend"
  hx-disabled-elt="find button"
  <% if (locals.oob) { %>hx-swap-oob="true"<% } %>
>
  <h2 class="whitespace-nowrap sm:basis-full">Add a trade</h2>
  <p id="status" class="form-error" role="alert"></p>
  <input class="rounded-md border border-slate-300 px-3 py-2" type="text" name="name" placeholder="Politician (Last, First)">
  <input class="rounded-md border border-slate-300 px-3 py-2" type="text" name="stock" placeholder="Stock">
  <!-- Makes it so that the minimum is 1 and it can only go up by one (like you can't have 1.05 of a stock)-->
  <input class="rounded-md border border-slate-300 px-3 py-2" type="number" name="shares" placeholder="Shares" min="1" step="1">
  <input class="rounded-md border border-slate-300 px-3 py-2" type="number" name="pricePerShare" placeholder="Price per share ($)" min="0.01" step="0.01">
  <button class="cursor-pointer whitespace-nowrap rounded-md bg-[#0f2a4a] px-[1.1rem] py-2 font-semibold text-white" type="submit">Add Trade</button>
</form>
