<li class="list-none">
  <span><strong><%= politician.name %>:</strong> <%= politician.party %></span>
  <button
    class="cursor-pointer rounded-md border border-red-400 bg-white px-3 py-1 m-1 text-red-700 transition-colors duration-200 hover:border-red-600 hover:bg-red-600 hover:text-white active:scale-95 active:bg-red-800 active:text-white active:border-0"
    type="button"
    hx-delete="/politicians/<%= encodeURIComponent(politician.name) %>"
    hx-target="closest li"
    hx-swap="outerHTML"
    hx-disabled-elt="this"
  >
    Delete
  </button>
</li>
